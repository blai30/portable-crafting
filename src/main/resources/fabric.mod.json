{
  "schemaVersion": 1,
  "id": "portablecrafting",
  "version": "${version}",
  "name": "Portable Crafting",
  "description": "Allows players to open Crafting Table UI by right-clicking on the crafting result slot from the Player inventory.",
  "authors": [
    "Brian Lai"
  ],
  "contact": {
    "homepage": "https://www.brianlai.dev/",
    "sources": "https://github.com/blai30/portable-crafting"
  },
  "license": "CC0-1.0",
  "icon": "assets/modid/icon.png",
  "environment": "server",
  "entrypoints": {
    "main": [
      "com.blai30.PortableCrafting"
    ]
  },
  "mixins": [
    "mixin.modid.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.13",
    "minecraft": ">=1.21.0",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}